{
  "name": "git-created-date",
  "version": "0.1.0",
  "description": "Sets the created date of a page from the earliest git commit that touched the file, instead of the build-time filesystem timestamp",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@quartz-community/types": "^0.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "quartz": {
    "name": "git-created-date",
    "displayName": "Git Created Date",
    "category": "transformer",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "defaultOrder": 11,
    "defaultEnabled": true,
    "defaultOptions": {}
  }
}
